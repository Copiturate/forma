# Reference only: Spring Boot does not automatically load .env.
# Export these variables in your shell (see README).
PORT=8080
FORMA_ADMIN_USERNAME=studio
# Set a unique password with at least 12 characters to enable the studio login.
FORMA_ADMIN_PASSWORD=
FORMA_DB_URL=jdbc:h2:file:./data/forma;DB_CLOSE_ON_EXIT=FALSE;WRITE_DELAY=0
FORMA_DB_USERNAME=sa
FORMA_DB_PASSWORD=
# Enable behind a trusted HTTPS reverse proxy; local HTTP needs false.
FORMA_COOKIE_SECURE=false
